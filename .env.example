# Copy this file to .env.local and fill in the three values.
# On Vercel, add the same three under Project Settings -> Environment Variables.
# Nothing secret goes in here: the key below is the *publishable* one, which is
# safe in a browser. Row Level Security in Supabase is what protects the data.

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Your live address, no slash at the end. Used for canonical links, the sitemap,
# app-ads.txt and sharing images. Leave it out locally and it falls back to
# http://localhost:3000; on Vercel it falls back to the project's domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
