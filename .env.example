# Copy this file to .env.local and fill it in.
# On Vercel, add the same names under Project Settings -> Environment Variables.
# The Supabase block below holds nothing secret: that key is the *publishable*
# one, which is safe in a browser, and Row Level Security is what protects the
# data. The R2 block at the bottom is the opposite — read the note above it.

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Your live address, no slash at the end. Used for canonical links, the sitemap,
# app-ads.txt and sharing images. Leave it out locally and it falls back to
# http://localhost:3000; on Vercel it falls back to the project's domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# ---------------------------------------------------------------------------
# Cloudflare R2 — only for the GATE papers page (/admin/gate-pyqs)
# ---------------------------------------------------------------------------
# These three ARE secret, unlike everything above. They are an account-wide key
# to every file in the bucket, so:
#
#   * do NOT prefix any of them with NEXT_PUBLIC_ — that would ship them to
#     every visitor's browser, in plain text, forever;
#   * on Vercel add them as ordinary (server) environment variables.
#
# Only the server action in src/app/admin/(dashboard)/gate-pyqs/actions.ts
# reads them. It checks the caller is a signed-in admin first, and hands back
# file names and public links — never a credential.
#
# Leave them out and the rest of the dashboard works exactly as before; the
# GATE papers page just says which ones are missing.

# Cloudflare dashboard -> R2 -> the account id in the sidebar
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# R2 -> Manage API tokens -> Create API token, with Object Read.
# "Object Read only" is enough: this page lists files, it never uploads.
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Both have working defaults that match the live bucket, so set them
# only if that ever changes. R2_PUBLIC_BASE_URL is the r2.dev address (or your
# custom domain) that ends up in every link students' phones open — not a
# secret, since it is already in the database.
# R2_BUCKET=vtu-resources
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
